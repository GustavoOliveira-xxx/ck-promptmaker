{
  "name": "ck-promptmaker",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Assistente local para transformar atividades em prompts completos.",
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs --dist",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "mammoth": "1.11.0",
    "pdfjs-dist": "5.4.149"
  }
}
