{
  "id": "./",
  "name": "CK Promptmaker",
  "short_name": "CK",
  "description": "Sua atividade, pronta para virar um prompt completo.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#06030b",
  "theme_color": "#06030b",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Fotografar e preencher com IA",
      "short_name": "Preencher com IA",
      "url": "./?ai=1",
      "icons": [
        {
          "src": "./assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Nova atividade",
      "short_name": "Nova",
      "url": "./?new=1",
      "icons": [
        {
          "src": "./assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Fotografar atividade",
      "short_name": "Câmera",
      "url": "./?camera=1",
      "icons": [
        {
          "src": "./assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".docx",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "text/plain",
            ".txt",
            ".md"
          ]
        }
      ]
    }
  }
}
